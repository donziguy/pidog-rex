# Rex v2 environment. Copy to ~/.config/pidog/security_dog.env (chmod 600). Leave blank to use defaults.
XAI_API_KEY=
# SuperGrok / X Premium+. Leave blank. python3 grok_login.py writes these.
# REX_GROK_AUTH: auto (prefer subscription), sub, or api.
GROK_OAUTH_TOKEN=
GROK_OAUTH_REFRESH_TOKEN=
REX_GROK_AUTH=
PIDOG_GROK_IMAGE_WIDTH=
PIDOG_GROK_MIN_INTERVAL=
PIDOG_GROK_MODEL=
PIDOG_GROK_RETRIES=
PIDOG_GROK_TIMEOUT=
PIDOG_HEAD_PITCH=
PIDOG_HEAD_PITCH_COMP=
PIDOG_IDLE_MUTTER_COOLDOWN=
PIDOG_MEMORY_PATH=
PIDOG_OLLAMA=
PIDOG_OLLAMA_MODEL=
PIDOG_OLLAMA_URL=
PIDOG_PATROL_STEP_=
PIDOG_PIPER_MODEL=
PIDOG_PRIMARY_HUMAN=
PIDOG_REX_BATTERY_LOW_V=
PIDOG_REX_CLEAR_CM=
PIDOG_REX_EMPTY_READS=
# Seconds of no valid ultrasonic echo while walking before a trip. PIDOG_ wins over REX_. Default 1.0.
PIDOG_REX_EMPTY_SECONDS=
REX_EMPTY_SECONDS=
PIDOG_REX_PATROL_SECONDS=
PIDOG_REX_REST_SECONDS=
PIDOG_REX_STOP_CM=
# Obstacle stop while walking faster than speed 80. Never used below PIDOG_REX_STOP_CM. Default 35.
PIDOG_REX_FAST_STOP_CM=
PIDOG_REX_TILT_DEG=
PIDOG_REX_TURN_CM=
PIDOG_REX_WALK_SPEED=
PIDOG_REX_WALK_STEPS=
PIDOG_ROAST_COOLDOWN=
PIDOG_SCENE_DIFF=
PIDOG_SFX=
PIDOG_SFX_VOLUME=
PIDOG_SOUND_COOLDOWN=
PIDOG_SOUND_FRONT_OFFSET=
PIDOG_SOUND_PAN_AXIS=
PIDOG_SOUND_TRACKING=
PIDOG_SOUND_YAW_INVERT=
PIDOG_SOUND_YAW_LIMIT=
PIDOG_STT=
PIDOG_STT_DEVICE=
PIDOG_STT_MIN_PEAK=
PIDOG_STT_MODEL=
PIDOG_STT_PYTHON=
PIDOG_STT_RECORD_SECONDS=
# Local web dashboard. Off unless REX_DASH=1. Token is required; leave it blank here.
REX_DASH=
REX_DASH_HOST=
REX_DASH_PORT=
REX_DASH_TOKEN=
REX_DASH_ALLOW_PATROL=
REX_DASH_LOG_LINES=
# Local face recognition. Off unless REX_FACE=1. Embeddings go to REX_FACE_DIR
# (default ~/.config/pidog/faces), not the repo. Backend: auto, pillow, opencv, face_recognition.
REX_FACE=
REX_FACE_BACKEND=
REX_FACE_DIR=
REX_FACE_THRESHOLD=
REX_FACE_GREET_COOLDOWN=
REX_FACE_STRANGER_COOLDOWN=
REX_YUNET_MODEL=
REX_SFACE_MODEL=
# Guard alerts. Off unless REX_GUARD=1, and disarmed unless REX_GUARD_ARMED=1.
# Leave the topic, token, and webhook empty here.
REX_GUARD=
REX_GUARD_ARMED=
REX_GUARD_COOLDOWN=
REX_GUARD_MOTION=
REX_NTFY_TOPIC=
REX_NTFY_SERVER=
REX_NTFY_TOKEN=
REX_ALERT_WEBHOOK_URL=
# Follow is supervised and flag-only (--follow). These tune a session; they do not turn it on.
# Do not put --follow in rex.service.
REX_FOLLOW_MAX_STEPS=
REX_FOLLOW_MAX_SECONDS=
REX_FOLLOW_LOST_TICKS=
REX_FOLLOW_SPEED=
# Home Assistant MQTT discovery. Off unless REX_MQTT=1. Leave the broker host empty;
# Rex will not connect without one. Do not put a password or an address here.
REX_MQTT=
REX_MQTT_HOST=
REX_MQTT_PORT=
REX_MQTT_USER=
REX_MQTT_PASSWORD=
REX_MQTT_PREFIX=
# Wake word. Off unless REX_WAKE_WORD=1. Phrase is "hey rex".
# REX_STT_ENGINE is vosk (default) or whisper (faster-whisper tiny/base, CPU int8).
REX_WAKE_WORD=
REX_WAKE_WINDOW=
REX_WAKE_THRESHOLD=
REX_WAKE_MODEL=
REX_STT_ENGINE=
REX_WHISPER_MODEL=
REX_WHISPER_COMPUTE=
