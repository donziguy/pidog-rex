[Unit]
Description=Rex v2 PiDog (shelf mode; walking only with --patrol)
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/pidog-rex
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/pidog/security_dog.env
# Shelf mode only. Never add --patrol or --follow here.
ExecStart=/usr/bin/python3 %h/pidog-rex/main.py
# SIGTERM -> main loop exits -> legs cleared, stop_and_lie, Pidog.close()
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=60
Restart=on-failure
RestartSec=15
StandardOutput=append:%h/pidog-rex/rex.log
StandardError=append:%h/pidog-rex/rex.log

[Install]
WantedBy=default.target
